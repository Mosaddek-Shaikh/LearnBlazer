@page "/LearnBlazor/LoadTest"

@inject HttpClient Http
@inject NavigationManager Nav


<h3>HTTP Performance and Capacity Testing</h3>

INSTRUCTION : 
The objective is to apply varying loads of HTTP requests per second to evaluate the worker’s capacity to process them. Repeat the test at 500, 1000, 1500, and 2000 requests per second, and observe how the actual request rate behaves. <br /><br />
Step 1: Drag the slider to approximately 500 requests per second. Click “Start Load”, and let it run for about one minute. <br />
Step 2: Click on the "Stop Load" button and review the resulting performance metrics. <br />
Step 3: Repeat Steps 1 and 2 using initial load levels of about 1000, 1500, and 2000 requests per second to evaluate scaling behavior under increasing load. <br />
Step 4: Review the computed capacity estimates, then select Reset to clear all test data and prepare for the next run. <br /> <br /> <br />




<p>Requests per second: @requestsPerSecond</p>

<input type="range" class="load-slider::-webkit-slider-runnable-track" min="1" max="3000" @bind="requestsPerSecond" /><br /><br />


<button class="btn btn-primary" @onclick="StartLoad">Start Load</button>
<button class="btn btn-danger" @onclick="StopLoad">Stop Load</button>
<button class="btn btn-success" @onclick="Reset">Reset</button><br /><br />

<br />
<h3> Performance Metrics </h3>
<br />
Status : @status <br />
Duration : @Duration <br />
Actual Http requests sent : @Counter <br />
Actual Requests sent per second : @ActualrequestsPerSecond <br /><br />

<h3> Capacity Estimation </h3>
Estimated Capacity of Http requests (Avg of last @stoploadcounter tests) : 
@* For loop pass count : @looppasscount <br /> *@

<br />



@code {
    private int requestsPerSecond = 10;
    private bool running = false;
    private string status = "";
    private DateTime StartTime;
    private DateTime EndTime; 
    private string Duration;
    private int totalprocessed;
    private int Counter = 0;
    private int seconds = 0;
    private float ActualrequestsPerSecond = 10;
    private int loopcount = 0;
    private int looppasscount = 0;
    private int stoploadcounter = 0;

    private async Task StartLoad()
    {
        running = true;
        status = "Load generation started.";
        StartTime = DateTime.Now;
        Counter = 0;
        loopcount = 0;
        while (running)
        {
            for (int i = 0; i < requestsPerSecond; i++)
            {
                var url = Nav.BaseUri + "ping";
                await Http.GetAsync(url);
                Counter = Counter + 1;
                loopcount = loopcount + 1;
                //_ = await Http.GetAsync("/ping"); // hits your own app
            }

            await Task.Delay(1000);

        }
    }

    private Task StopLoad()
    {
        running = false;
        status = "Load generation stopped.";
        EndTime = DateTime.Now;
        var diff = EndTime - StartTime;

        var formatted = $"{diff.Hours}h {diff.Minutes}m {diff.Seconds}s";

        Duration = formatted.ToString();
        TimeSpan diff1 = EndTime - StartTime;
        seconds = Convert.ToInt32(diff1.TotalSeconds);
        ActualrequestsPerSecond = Counter / seconds;
        looppasscount = loopcount / requestsPerSecond;
        stoploadcounter = stoploadcounter + 1;
        return Task.CompletedTask;
    }

    private Task Reset()
    {

        Counter = 0;
        Duration = "";
        requestsPerSecond = 10;
        status = "";
        ActualrequestsPerSecond = 0;
        loopcount = 0;
        looppasscount = 0;
        stoploadcounter = 0;
        return Task.CompletedTask;
    }


}
