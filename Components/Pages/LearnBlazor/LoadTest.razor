@page "/LearnBlazor/LoadTest"
@using ApexCharts
@using Models
@using System.Collections


@inject HttpClient Http
@inject NavigationManager Nav


<h3>HTTP Performance and Capacity Assessment</h3>

 
The objective is to apply varying loads of HTTP requests per second to evaluate the worker’s capacity to process them. Please follow the steps below. <br /><br />
Step 1: Drag the slider to 500 tickmark and click “Start Load”, and let it run for about 4-5 minute. <br />
Step 2: Click on the "Step Up 500" button, review the resulting performance metrics and wait about another 4-5 mins. <br />
Step 3: Repeat Step 2 until you reach 7000 mark to evaluate scaling behavior under the maximum load. <br />
Step 4: Review the computed capacity estimates, then select Reset to clear all test data and prepare for the next run. <br />
Step 5: Click on the button "Create RPS VS Load Chart" and analyze the behaviour of RPS values.<br /> <br />




<p>Requests per second: @requestsPerSecond</p>

<input type="range" class="load-slider" min="0" max="7000" step="500" style="width: 400px" list= "tickmarks" @bind="requestsPerSecond" />
<br />
<br />
<datalist id="tickmarks">
    <option value="0"></option>
    <option value="500"></option>
    <option value="1000"></option>
    <option value="1500"></option>
    <option value="2000"></option>
    <option value="2500"></option>
    <option value="3000"></option>
    <option value="3500"></option>
    <option value="4000"></option>
    <option value="4500"></option>
    <option value="5000"></option>
    <option value="5500"></option>
    <option value="6000"></option>
    <option value="6500"></option>
    <option value="7000"></option>
</datalist>


<button class="btn btn-primary" @onclick="StartLoad">Start Load</button>
<button class="btn btn-secondary" @onclick="StepUp">Step Up 500 </button>
<button class="btn btn-danger" @onclick="StopLoad">Stop Load</button>
<button class="btn btn-success" @onclick="Reset">Reset</button><br /><br />


<br />
<h3> Performance Assessment </h3>
<br />
Status : @status <br />
Duration : @Duration <br />
Actual Http requests sent : @Counter <br />
Actual Requests sent per second : @ActualrequestsPerSecond <br /><br />

<h3> Capacity Assessment </h3>
@*Estimated Capacity of Http requests (Avg of last @stoploadcounter tests) : 
 For loop pass count : @looppasscount <br /> *@ 

<br />

<button class="btn btn-success" @onclick="CreateRPSChartData">Create RPS vs Load Chart</button>
<br />
<br />

<ApexChart TItem="LoadPoint" Options="chartOptions" @ref="chart">
    
    <ApexPointSeries TItem="LoadPoint"
                     Name="Sample Line"
                     Items="points"
                     SeriesType="SeriesType.Line"
                     XValue="@(p => p.X)"
                     YValue="@(p => p.Y)"
                     ShowDataLabels
                     
    >
    </ApexPointSeries>
</ApexChart>




@code {
    [Inject] public IApexChartService ApexChartService { get; set; }
    private int requestsPerSecond = 0;
    private bool running = false;
    private string status = "";
    private DateTime StartTime;
    private DateTime EndTime; 
    private string Duration;
    private int totalprocessed;
    private int Counter = 0;
    private int seconds = 0;
    private float ActualrequestsPerSecond = 0;
    private int loopcount = 0;
    private int looppasscount = 0;
    private int stoploadcounter = 0;
    private List<int> Persecond = new List<int>();
    private List<int> RPS = new List<int>();
    private int secondcounter = 0; 
    private ApexChartOptions<LoadPoint> chartOptions;



    private async Task StartLoad()
    {
        running = true;
        status = "Load generation started.";
        StartTime = DateTime.Now;
        Counter = 0;
        loopcount = 0;
        secondcounter = 0;
        while (running)
        {
            for (int i = 0; i < requestsPerSecond; i++)
            {
                var url = Nav.BaseUri + "ping";
                await Http.GetAsync(url);
                Counter = Counter + 1;
                loopcount = loopcount + 1;
                //_ = await Http.GetAsync("/ping"); // hits your own app
            }

            await Task.Delay(1000);

        }
    }

    private Task StopLoad()
    {
        running = false;
        status = "Load generation stopped.";
        EndTime = DateTime.Now;
        var diff = EndTime - StartTime;

        var formatted = $"{diff.Hours}h {diff.Minutes}m {diff.Seconds}s";

        Duration = formatted.ToString();
        TimeSpan diff1 = EndTime - StartTime;
        seconds = Convert.ToInt32(diff1.TotalSeconds);
        ActualrequestsPerSecond = Counter / seconds;
        Persecond.Add(requestsPerSecond);
        RPS.Add((int) ActualrequestsPerSecond);
        looppasscount = loopcount / requestsPerSecond;
        stoploadcounter = stoploadcounter + 1;
        return Task.CompletedTask;
    }


    private Task StepUp()
    {
        running = true;
        status = "Load stepping up 500.";
        EndTime = DateTime.Now;
        var diff = EndTime - StartTime;

        var formatted = $"{diff.Hours}h {diff.Minutes}m {diff.Seconds}s";

        Duration = formatted.ToString();
        TimeSpan diff1 = EndTime - StartTime;
        seconds = Convert.ToInt32(diff1.TotalSeconds);
        ActualrequestsPerSecond = Counter / seconds;
        Persecond.Add(requestsPerSecond);
        RPS.Add((int)ActualrequestsPerSecond);
        looppasscount = loopcount / requestsPerSecond;
        stoploadcounter = stoploadcounter + 1;
        requestsPerSecond = requestsPerSecond + 500;
        return Task.CompletedTask;
    }

    private Task Reset()
    {

        Counter = 0;
        Duration = "";
        requestsPerSecond = 0;
        status = "";
        ActualrequestsPerSecond = 0;
        loopcount = 0;
        looppasscount = 0;
        stoploadcounter = 0;
        secondcounter = 0;
        return Task.CompletedTask;
    }
    private int MinX;
    private int MaxX;
    private int MinY;
    private int MaxY;



    private ApexChart<LoadPoint> chart; 
    private List<LoadPoint> points = new();

  


    private async Task CreateRPSChartData()
    {
        points = new List<LoadPoint>();

        for (int i = 0; i < Persecond.Count && i < RPS.Count; i++)
        {
            points.Add(new LoadPoint
            {
                X = Persecond[i],
                Y = RPS[i]
            });
        }
        if (points.Count == 0) return;


        MinX = points.Min(p => p.X);
        MaxX = points.Max(p => p.X);
        MinY = points.Min(p => p.Y);
        MaxY = points.Max(p => p.Y);


     


        @*OnInitialized();*@
        chartOptions = new ApexChartOptions<LoadPoint>
        {
            Chart = new Chart
            {
                Toolbar = new Toolbar
                {
                    Show = false
                },
                DropShadow = new DropShadow
                {
                    Enabled = true,
                    Color = "",
                    Top = 18,
                    Left = 7,
                    Blur = 10,
                    Opacity = 0.2d
                }
            },
            
            DataLabels = new ApexCharts.DataLabels
            {
                Enabled = true, 
                Formatter = @" function (val, opts) { var point = opts.w.config.series[opts.seriesIndex].data[opts.dataPointIndex]; return point.x + ', ' + val; }",
                OffsetY = -6d
            },
            Grid = new Grid
            {
                BorderColor = "#e7e7e7",
                Row = new GridRow
                {
                    Colors = new List<string> { "#f3f3f3", "transparent" },
                    Opacity = 0.5d
                }
            },

            Colors = new List<string> { "#77B6EA", "#545454" },
            Markers = new Markers { Shape = MarkerShape.Circle, Size = 5, FillOpacity = new Opacity(0.8d) },
            Stroke = new Stroke { Curve = Curve.Smooth },
            Legend = new Legend
            {
                Position = LegendPosition.Top,
                HorizontalAlign = ApexCharts.Align.Right,
                Floating = true,
                OffsetX = -5,
                OffsetY = -25
            },



          Xaxis = new XAxis
          {
              Type = XAxisType.Numeric,
              Min = MinX,
              Max = MaxX,
              Labels = new XAxisLabels
              {
                  Formatter = "function(value) { return value % 500 === 0 ? value : ''; }"
              }
          },
                Yaxis = new List<YAxis>
            {
                new YAxis
                {
                    Min = MinY,
                    Max = MaxY,
                    Labels = new YAxisLabels
                    {
                        Formatter = "function(value) { return value % 50 === 0 ? value : ''; }"
                    }
                }
            }
        };
       
        

        await chart.UpdateSeriesAsync();
        StateHasChanged();
    }

   

    




}
